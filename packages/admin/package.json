{
  "name": "opencode-admin",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:backend": "bun run --watch src/index.ts",
    "dev:frontend": "vite dev ui",
    "dev": "bun concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:generate": "bun drizzle-kit generate",
    "build:frontend": "vite build ui",
    "build:bin": "bun run script/build.ts",
    "build": "bun run build:frontend && bun run build:bin"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "1.3.9",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.7",
    "@opencode-ai/ui": "workspace:*",
    "@solidjs/router": "^0.15.3",
    "@types/yargs": "17.0.35",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.1",
    "glob": "13.0.6",
    "hono": "4.11.9",
    "minimatch": "10.2.4",
    "mysql2": "3.17.2",
    "solid-js": "^1.9.4",
    "xdg-basedir": "5.1.0",
    "yargs": "18.0.0",
    "zod": "4.3.6"
  }
}